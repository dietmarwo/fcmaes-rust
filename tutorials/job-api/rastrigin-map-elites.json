          -5.12
        ],
        "upper": [
          5.12
        ],
        "broadcast": true
      }
    },
    "archive": {
      "capacity": 400
    },
    "optimizer": {
      "kind": "map_elites",
      "parameters": {
        "chunk_size": 20,
        "variation": "sbx"
      }
    },
    "seed": 42,
    "runs": 8,
    "generations": 1000
  }
}
