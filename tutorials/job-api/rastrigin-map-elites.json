{
  "schema_version": "optimization.job/0.1",
  "request_key": "tutorial.fcmaes.rastrigin-map-elites.v1",
  "worker": "fcmaes",
  "payload_schema": "fcmaes.map-elites/1",
  "resources": {
    "cpu_slots": 8,
    "outer_workers": 8,
    "inner_threads": 1
  },
  "limits": {
