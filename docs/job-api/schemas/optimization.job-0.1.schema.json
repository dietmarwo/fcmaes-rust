{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optimization-job-api:schema:optimization.job-0.1",
  "title": "optimization.job/0.1 envelope",
  "description": "A job submitted to optimization-run. The payload is defined by the worker profile named in payload_schema; `optimization-run problems describe WORKER` lists the profiles. Rules a schema cannot express: outer_workers * inner_threads <= cpu_slots; request_key is limited to 200 bytes; input files are relative, contained in the specification's directory and at most 64 MiB.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_key",
    "worker",
    "payload_schema",
    "payload",
    "resources",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "optimization.job/0.1"
    },
    "request_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Idempotency key. The same key with the same normalized content returns the existing job; different content is rejected (request_key_conflict)."
    },
    "worker": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,80}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "description": "ID of a registered worker."
    },
    "payload_schema": {
      "type": "string",
      "minLength": 1,
      "description": "Versioned worker profile, for example fcmaes.retry/1 or lp-ip.solve/1."
    },
    "payload": {
      "type": "object",
      "description": "Profile-specific, strict: unknown fields are rejected."
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_slots",
        "outer_workers",
        "inner_threads"
      ],
      "properties": {
        "cpu_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "outer_workers": {
          "type": "integer",
          "minimum": 1
        },
        "inner_threads": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "grace_seconds"
      ],
      "properties": {
        "wall_time_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 31536000
        },
        "grace_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "file",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "task_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "description": "Normally omitted; the worker fills it during validation."
    }
  }
}
